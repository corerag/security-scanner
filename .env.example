# Copy this file to .env and fill in real values.
# Two separate .env files are typical: one next to the agent (on the
# scanned machine) and one next to the server (wherever it runs). Both
# are read from the project root by python-dotenv, so if you run agent
# and server from the same checkout, one shared .env also works.

# ----------------------------------------------------------------------
# Shared between agent and server
# ----------------------------------------------------------------------
# Shared secret the agent sends as the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# ----------------------------------------------------------------------
# Agent settings (agent/config.py)
# ----------------------------------------------------------------------
# Base URL of the FastAPI report server.
SERVER_URL=http://127.0.0.1:8000

# Email address of the person who owns/uses the scanned machine. The
# server sends the report summary here.
OWNER_EMAIL=owner@example.com

# Optional display name for the owner, used only in report metadata.
OWNER_NAME=

# Optional free-text note included in the report and the email.
SCAN_NOTES=

# Comma-separated list of extra file paths to SHA-256 hash on every scan,
# in addition to the executables auto-discovered from persistence entries.
EXTRA_HASH_PATHS=

# If "true", also hash the executable of every running process. Off by
# default because it can noticeably slow down a scan.
HASH_PROCESS_EXECUTABLES=false

# Seconds to wait for the server to respond when submitting a report.
REQUEST_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------------
# Server settings (server/config.py)
# ----------------------------------------------------------------------
# Your email address - every report is sent here in addition to the
# machine owner's address.
ADMIN_EMAIL=you@example.com

# SMTP settings used to send the report emails. Example values for Gmail:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, and an
# App Password (not your normal Gmail password) for SMTP_PASSWORD.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
# Defaults to SMTP_USERNAME if left blank.
SMTP_FROM_ADDRESS=

# Directory (relative or absolute) where received reports are saved as JSON.
STORAGE_DIR=./reports
