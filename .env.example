# Copy this file to .env and fill in real values.
#
# Two deployment shapes are supported:
#   1. Agent + server: the agent POSTs reports to the FastAPI server, which
#      emails them. Set DELIVERY_MODE=server (the default).
#   2. Portable/offline agent (e.g. run from a USB drive on a machine that
#      can't reach your server): set DELIVERY_MODE=direct_email and the
#      agent emails the report itself via SMTP, no server required. See
#      "Portable agent" in README.md for the full walkthrough, including
#      building a standalone .exe with PyInstaller.
#
# Two separate .env files are typical: one next to the agent (on the
# scanned machine) and one next to the server (wherever it runs). Both
# are read from the project root by python-dotenv, so if you run agent
# and server from the same checkout, one shared .env also works.

# ----------------------------------------------------------------------
# Agent settings (agent/config.py)
# ----------------------------------------------------------------------
# "server" (default) - submit reports via HTTP to SERVER_URL / API_KEY.
# "direct_email" - skip the server entirely and email the report using
# the SMTP_* / ADMIN_EMAIL settings below.
DELIVERY_MODE=server

# Email address of the person who owns/uses the scanned machine. The
# report is always emailed here (in both delivery modes).
OWNER_EMAIL=owner@example.com

# Optional display name for the owner, used only in report metadata.
OWNER_NAME=

# Optional free-text note included in the report and the email.
SCAN_NOTES=

# Comma-separated list of extra file paths to SHA-256 hash on every scan,
# in addition to the executables auto-discovered from persistence entries.
EXTRA_HASH_PATHS=

# If "true", also hash the executable of every running process. Off by
# default because it can noticeably slow down a scan.
HASH_PROCESS_EXECUTABLES=false

# Optional: VirusTotal hash-reputation lookups (agent/virustotal.py). If set,
# every collected SHA-256 file hash is looked up against VirusTotal and the
# number of engines that flag it as malicious is added to the report. Only
# the hash is ever sent - never file contents. Leave blank to skip this
# entirely; the scan still runs fine without it. Lookups are throttled to
# stay within the free tier's ~4 requests/minute limit, so a scan with many
# hashes to check can take a while.
# Get a free API key at https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# --- DELIVERY_MODE=server only ---
# Base URL of the FastAPI report server.
SERVER_URL=http://127.0.0.1:8000
# Shared secret the agent sends as the X-API-Key header; must match the
# server's API_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string
# Seconds to wait for the server to respond when submitting a report.
REQUEST_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------------
# Email settings - used by the server, AND by the agent when
# DELIVERY_MODE=direct_email
# ----------------------------------------------------------------------
# Your email address - every report is sent here in addition to the
# machine owner's address.
ADMIN_EMAIL=you@example.com

# SMTP settings used to send the report emails. Example values for Gmail:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, and an
# App Password (not your normal Gmail password) for SMTP_PASSWORD.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
# Defaults to SMTP_USERNAME if left blank.
SMTP_FROM_ADDRESS=

# ----------------------------------------------------------------------
# Server-only settings (server/config.py)
# ----------------------------------------------------------------------
# Directory (relative or absolute) where received reports are saved as JSON.
STORAGE_DIR=./reports
